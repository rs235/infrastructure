name: Kubernetes Ansible Check

on:
  pull_request:
    paths:
      - "ansible/inventories/home/**"
      - "ansible/playbooks/kubernetes.yml**"
      - "ansible/roles/**"
      - "ansible/requirements.yml"
      - "ansible/ansible.cfg"

  workflow_dispatch:

permissions:
  contents: read
  pull-requests: write

jobs:
  kubernetes-ansible-check:
    uses: ./.github/workflows/template-ansible-check.yml
    with:
      working-directory: ansible
      concurrency-group: ansible-home-kubernetes
      ansible-playbook: kubernetes
      ansible-group: k8s_cluster
    secrets: inherit