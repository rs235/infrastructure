---
name: Home - Ansible Check - kubernetes
on:
  pull_request:
    paths:
      - "ansible/inventories/home/**"
      - "ansible/playbooks/kubernetes.yml"
      - "ansible/roles/**"
      - "ansible/requirements.yml"
      - "ansible/ansible.cfg"

  workflow_dispatch:

permissions:
  contents: read
  pull-requests: write

jobs:
  ansible-check-kubernetes:
    uses: ./.github/workflows/reusable-ansible-check.yml
    with:
      working-directory: ansible
      concurrency-group: home-ansible-kubernetes
      runner: '["self-hosted", "Linux", "X64", "infra", "home"]'
      ansible-playbook: kubernetes
      ansible-inventory-group: k8s_cluster

    secrets:
      ansible_ssh_private_key: ${{ secrets.ANSIBLE_SSH_PRIVATE_KEY }}
      ansible_vault_password: ${{ secrets.ANSIBLE_VAULT_PASSWORD }}
